# Build context is the repo root, so this file lives here rather than
# beside docker/Dockerfile. The image COPYs only pyproject/uv.lock/README,
# so this is about context upload speed -- `.git` alone is 830 MB.
.git
.github
.venv
.pytest_cache
.ruff_cache
**/__pycache__
**/*.pyc
*.egg-info

# Paper, figures and the empty vendored tree: not runtime inputs.
paper
img
hydrax

# Outputs; the pod symlinks these onto the PVC.
oim/results
oim/recordings
MUJOCO_LOG.TXT
