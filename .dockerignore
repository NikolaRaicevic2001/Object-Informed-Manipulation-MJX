# Build context is the repo root, so this file lives here and not beside
# docker/Dockerfile -- that is the only place Docker looks for it.
# Everything listed stays out of the image.
# `.git` alone is 830 MB and nothing at runtime reads it.
.git
.github
.venv
.pytest_cache
.ruff_cache
**/__pycache__
**/*.pyc
*.egg-info

# Paper, figures and the empty vendored tree: not runtime inputs.
paper
img
hydrax

# Outputs. The container symlinks these onto the PVC anyway, so baking a
# local copy in would only be shadowed -- see nautilus/job.yaml.
oim/results
oim/recordings
MUJOCO_LOG.TXT
