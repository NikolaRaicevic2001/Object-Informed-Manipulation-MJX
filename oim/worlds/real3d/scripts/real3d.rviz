Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.55
    Tree Height: 700
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid 10 cm (base)
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: xarm_device
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.25
      Name: Base (xarm_device)
      Radius: 0.012
      Reference Frame: xarm_device
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      Name: Robot (/robot_description)
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.06
      Name: EE tip (xarm6_ee_tip)
      Radius: 0.006
      Reference Frame: xarm6_ee_tip
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.1
      Name: Object (fp_object_pose)
      Radius: 0.008
      Reference Frame: fp_object_pose
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.08
      Name: Obstacle 1 detected (obs_1_center)
      Radius: 0.008
      Reference Frame: obs_1_center
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.08
      Name: Obstacle 2 detected (obs_2_center)
      Radius: 0.008
      Reference Frame: obs_2_center
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.08
      Name: Obstacle 3 detected (obs_3_center)
      Radius: 0.008
      Reference Frame: obs_3_center
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.08
      Name: Camera (fp_camera_color_optical_frame)
      Radius: 0.006
      Reference Frame: fp_camera_color_optical_frame
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        fp_camera_color_optical_frame:
          Value: true
        fp_object_pose:
          Value: true
        obs_1_center:
          Value: true
        obs_2_center:
          Value: true
        obs_3_center:
          Value: true
        xarm6_ee_tip:
          Value: true
        xarm_device:
          Value: true
      Marker Scale: 1
      Name: Frame names
      Show Arrows: false
      Show Axes: false
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Planner scene (/scene_markers)
      Namespaces:
        block_start: true
        goal: true
        obstacles: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scene_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: xarm_device
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.4
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  Views:
    collapsed: true
  Width: 1600
