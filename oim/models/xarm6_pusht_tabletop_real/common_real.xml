<mujoco model="xarm6_pusht_tabletop_real_common">
  <!-- Shared by every real-table push-T scene (lab xArm6 + measured T-block).
       Real analogue of ../xarm6_pusht_tabletop/common.xml. World frame is the
       robot base frame (base at origin, applied in oim/tasks/pusht.py). -->
  <option timestep="0.01" gravity="0 0 -9.81" iterations="20" ls_iterations="20" integrator="implicitfast"/>

  <include file="../xarm6/xarm6.xml"/>

  <default>
    <geom friction="0.5 0.005 0.0001" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    <default class="goal"><geom conaffinity="0" contype="0" rgba="0 1 0 0.3"/></default>
    <default class="local_goal"><geom conaffinity="0" contype="0" rgba="0 0.30 0.95 0.25"/></default>
    <default class="obstacle"><geom conaffinity="1" contype="1" rgba="0.5 0.5 0.5 1"/></default>
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0.3 0.0 1"/>
    <!-- Room floor at the lab table's own foot, so the table reads as a table
         standing on it rather than z-fighting with the surface everything sits
         on. Same relationship ../xarm6_pusht_tabletop/common.xml has to its own
         table, at this table's height instead of IsaacGym's. -->
    <geom name="floor" size="0 0 .125" type="plane" pos="0 0 -0.91" material="groundplane"/>
    <!-- THE LAB TABLE. Measured: 1523 x 763 x 910 mm (W x D x H). MJCF `size`
         is half-extents, so 0.7615 x 0.3815 x 0.455, and the top surface is
         z = 0 -- the convention this whole scene family already uses (the
         block rests 0.2 mm above it, and README's bring-up checklist
         calibrates `base_z` so the MODEL floor lands on the REAL table).
         Modelled as one solid slab rather than a top plus legs: nothing in
         these scenes goes under the table, and the legs would only add geoms
         for MJX to collide.

         Placement is in the ROBOT BASE frame, which is this family's world
         frame (`world_frame="xarm_device"`, base at the origin). The arm is
         clamped at the middle of the REAR long edge, with the table's long
         axis along the base's y and its depth along the base's x.

         The base sits 0.05 m in from that rear edge -- it is clamped, so it
         really does perch close to the lip, closer than the 0.09 m base-shell
         radius would suggest. Only the near edge depends on this number.

         So the table spans x in [-0.05, 0.713], y in [-0.7615, 0.7615].
         Everything in every real scene is inside that: the block starts at
         (0.381, 0.343), the goal is at (0.381, -0.305), and the furthest
         obstacle sits at x = 0.521. The block's own footprint reaches
         x = 0.4255 at most, clearing the front edge by 0.25 m.

         Named "table" deliberately, not "table_visual". Two mechanisms read
         that name and both should see it: `oim/runtime/mjcf.py`'s
         SUPPORT_GEOM_NAMES, and `PushT._support_region`, which turns it into
         the table-edge keep-IN cost (`w_support`). That cost was silently
         inert here before -- the floor was a plane, and a plane has no edge
         to fall off. It is still worth ~0 in practice: the nearest legitimate
         pose clears every edge by more than the 0.10 m `support_margin`.
         `_SCENERY_GEOMS` in oim/tasks/pusht.py already excludes the name from
         the obstacle field, so it does not become one. -->
    <geom name="table" type="box" size="0.3815 0.7615 0.455" pos="0.3315 0 -0.455"
      rgba="0.95 0.95 0.95 1"/>
  </worldbody>

  <!-- Real arm start: SCENES[...].xarm6_arm_start_deg = [49.2,34.8,-80.6,0,45.9]
       deg -> rad (keyframe qpos is radians), then block SE(2) start
       (0.381,0.343,0). Gives the sim engine (build.py reads keyframe "start")
       the same initial pose the mock uses from arm_start_deg. -->
  <keyframe>
    <key name="start" qpos="0.85870 0.60737 -1.40673 0.0 0.80111 0.381 0.343 0.0"/>
  </keyframe>
</mujoco>