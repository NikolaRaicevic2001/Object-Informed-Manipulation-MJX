<mujoco model="xarm6_pusht_clutter_2">
  <!-- Real-table push-T scene (variant "clutter2"), measured on the lab
       xArm6. Same structure as ../xarm6_pusht_clutter/xarm6_pusht_clutter.xml,
       but with:
         - the real T-block dimensions (from a tape measure, see
           oim/tasks/pusht.py SCENES["clutter2"]["block"]),
         - three identical box obstacles (YCB pudding boxes, 4.25 x 3.5 in),
         - a goal placed at the real workspace target.
       Coordinates are in the MJX world frame, which for this scene is the
       robot base frame (base placed at the origin in code, so measured
       base-relative positions are used directly). The arm base placement and
       the initial block pose are applied in oim/tasks/pusht.py, not here. -->
  <option timestep="0.01" gravity="0 0 -9.81" iterations="20" ls_iterations="20" integrator="implicitfast"/>

  <include file="../xarm6/xarm6.xml"/>

  <default>
    <geom friction="0.5 0.005 0.0001" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    <default class="goal">
      <geom conaffinity="0" contype="0" rgba="0 1 0 0.3"/>
    </default>
    <!-- The object block's horizon endpoint x^{o*}_H, drawn as a ghost of
         the pushed object -- what the robot block aims at under
         `local_goal` tracking (see oim/tasks/pusht.py). Blue, not the
         goal's green: it is the last pose of the object block's own plan,
         which oim/runtime/overlay.py already draws in blue. Fainter
         than the goal, because it moves every control step and must not
         compete with the fixed target. -->
    <default class="local_goal">
      <geom conaffinity="0" contype="0" rgba="0 0.30 0.95 0.25"/>
    </default>
    <default class="obstacle">
      <geom conaffinity="1" contype="1" rgba="0.5 0.5 0.5 1"/>
    </default>
  </default>

  <worldbody>
    <!-- Goal marker at the real target (world = base frame): (0.381, -0.305),
         yaw = 90 deg -> quat (cos45, 0, 0, sin45). Geoms mirror the block. -->
    <body name="goal" mocap="true" pos="0.381 -0.305 0.03" quat="0.70711 0 0 0.70711">
      <geom class="goal" name="goal_crossbar" type="box" size="0.0445 0.0099 0.0298" pos="0.0 0.0099 0.0"/>
      <geom class="goal" name="goal_stem" type="box" size="0.0099 0.0397 0.0298" pos="0.0 -0.0397 0.0"/>
    </body>

    <!-- Ghost of the pushed object at the object block's horizon endpoint
         x^{o*}_H, moved every control step by the runners (mocap, so it is
         written straight into mocap_pos/mocap_quat and never simulated).
         Geoms mirror `block`'s exactly, at the same z, so its overlap with
         the block reads the same way the goal marker's does. `pos`/`quat`
         here are only the pre-first-plan placeholder; oim/runtime/mjcf.py
         parks it on the block's start pose. -->
    <body name="local_goal" mocap="true" pos="0.0 0.0 0.03" quat="1 0 0 0">
      <geom class="local_goal" name="local_goal_crossbar" type="box" size="0.0445 0.0099 0.0298" pos="0.0 0.0099 0.0"/>
      <geom class="local_goal" name="local_goal_stem" type="box" size="0.0099 0.0397 0.0298" pos="0.0 -0.0397 0.0"/>
    </body>

    <!-- Block body stays at the origin; its SE(2) pose is the T_x/T_y/T_z
         joint values, set to the start pose (0.381, 0.343, 0) in code. -->
    <body name="block" pos="0.0 0.0 0.03">
      <joint name="T_x" type="slide" axis="1 0 0" frictionloss="0.2943" damping="0.0"/>
      <joint name="T_y" type="slide" axis="0 1 0" frictionloss="0.2943" damping="0.0"/>
      <joint name="T_z" type="hinge" axis="0 0 1" frictionloss="0.011772" damping="0.0"/>
      <geom name="block_crossbar" type="box" size="0.0445 0.0099 0.0298" pos="0.0 0.0099 0.0" mass="0.05" rgba="0.2 0.45 0.85 1"/>
      <geom name="block_stem" type="box" size="0.0099 0.0397 0.0298" pos="0.0 -0.0397 0.0" mass="0.05" rgba="0.2 0.45 0.85 1"/>
    </body>

    <!-- Three pudding-box obstacles: 4.25 x 3.5 in -> half (0.054, 0.0445),
         rotated +90 deg. Positions are base-relative measurements. -->
    <geom class="obstacle" name="obs_1" type="box" size="0.054 0.0445 0.0298" pos="0.318 0.178 0.03" euler="0 0 90"/>
    <geom class="obstacle" name="obs_2" type="box" size="0.054 0.0445 0.0298" pos="0.229 -0.140 0.03" euler="0 0 90"/>
    <geom class="obstacle" name="obs_3" type="box" size="0.054 0.0445 0.0298" pos="0.521 -0.140 0.03" euler="0 0 90"/>
  </worldbody>

  <sensor>
    <framepos name="position" objtype="body" objname="block" reftype="body" refname="goal"/>
    <framequat name="orientation" objtype="body" objname="block" reftype="body" refname="goal"/>
  </sensor>
</mujoco>
