<mujoco model="xarm6_pusht_tabletop_tee">
  <!-- The table, T-block and goal shared by open_table, single_obstacle,
       shelf_gap and ycb_clutter. Those four IsaacGym tasks (sim_task01..04)
       differ *only* in their obstacle field: the same tee_block starts at
       the same pose and is pushed to the same goal in all four, so all of
       that lives here once and each scene file adds only its own
       obstacles.

       The camera is *not* included here: shelf_gap needs a steeper
       elevation than the other three to see over its shelves (its own
       comment has the derivation), so each scene now declares its own
       `<camera name="front">`, even the three that keep the original
       numbers verbatim -- one shared camera element can't have two
       different elevations depending on which file includes it.

       Positions are IsaacGym's own, re-origined as described in
       common.xml: xy shifted by (-0.7, +0.45) so the block starts at
       (0, 0), z shifted so the tabletop's top surface is z = 0.

       Keep in sync with those four entries in oim/utils/scenes.py (goal
       pose, footprint_kwargs) -- the planner's analytic object model is
       built from those numbers, and nothing checks the two agree at
       runtime except tests/test_scenes.py. -->

  <worldbody>
    <!-- IsaacGym's own "table" actor: box, full size 1.40 x 2.50 x 0.14 m,
         init_pos [1.0, 0.0, 0.07]. MJCF `size` is half-extents, so those
         halve. The arm base, block, obstacles and goal all fall well inside
         its footprint (x in [-0.4, 1.0], y in [-0.8, 1.7]). -->
    <geom name="table" type="box" size="0.70 1.25 0.07" pos="0.3 0.45 -0.07"
      rgba="0.95 0.95 0.95 1"/>

    <!-- Mirrors the block's geoms exactly, at the goal pose, so an aligned
         block occupies precisely the marker's volume -- overlap is the
         success criterion by eye, and the stem makes the 180-degree
         ambiguity of a bare crossbar impossible to misread. IsaacGym's goal
         is at (0.9, 0.30) with quat [0,0,1,0] (xyzw), i.e. a 180-degree
         flip about z from the block's spawn orientation; MJCF quat is wxyz,
         hence "0 0 0 1". -->
    <body name="goal" mocap="true" pos="0.2 0.75 0.025" quat="0 0 0 1">
      <geom class="goal" name="goal_crossbar" type="box" size="0.100 0.025 0.025" pos="0.0 0.0 0.0"/>
      <geom class="goal" name="goal_stem" type="box" size="0.025 0.050 0.025" pos="0.0 -0.075 0.0"/>
    </body>

    <!-- Ghost of the pushed object at the object block's horizon endpoint
         x^{o*}_H, moved every control step by the runners (mocap, so it is
         written straight into mocap_pos/mocap_quat and never simulated).
         Geoms mirror `block`'s exactly, at the same z, so its overlap with
         the block reads the same way the goal marker's does. `pos`/`quat`
         here are only the pre-first-plan placeholder; oim/runtime/mjcf.py
         parks it on the block's start pose. -->
    <body name="local_goal" mocap="true" pos="0.0 0.0 0.025" quat="1 0 0 0">
      <geom class="local_goal" name="local_goal_crossbar" type="box" size="0.100 0.025 0.025" pos="0.0 0.0 0.0"/>
      <geom class="local_goal" name="local_goal_stem" type="box" size="0.025 0.050 0.025" pos="0.0 -0.075 0.0"/>
    </body>

    <!-- Half-extents and stem offset are IsaacGym's assets/urdf/tee_block/
         tee_block.urdf verbatim (crossbar box "0.2 0.05 0.05", stem box
         "0.05 0.1 0.05" at y = -0.075; URDF `size` is full extents, MJCF
         `size` is half, so each is halved). Noticeably larger than the
         clutter scene's T.

         frictionloss is *not* IsaacGym's -- it is this repo's own tuning,
         shared by every PushT scene, so the simulated block obeys the same
         limit surface the analytic object model assumes:
         mu*m*g = 0.4*2.0*9.81 = 7.848 on the two slides, and
         c*r*mu*m*g = 1.0*0.06*7.848 = 0.47088 on the hinge. The two geom
         masses therefore sum to the 2.0 kg that PushT hands
         PlanarPushingObject, not the URDF's 0.5 kg. -->
    <body name="block" pos="0.0 0.0 0.025">
      <joint name="T_x" type="slide" axis="1 0 0" frictionloss="7.848" damping="0.0"/>
      <joint name="T_y" type="slide" axis="0 1 0" frictionloss="7.848" damping="0.0"/>
      <joint name="T_z" type="hinge" axis="0 0 1" frictionloss="0.47088" damping="0.0"/>
      <geom name="block_crossbar" type="box" size="0.100 0.025 0.025" pos="0.0 0.0 0.0" mass="1.0" rgba="0.2 0.45 0.85 1"/>
      <geom name="block_stem" type="box" size="0.025 0.050 0.025" pos="0.0 -0.075 0.0" mass="1.0" rgba="0.2 0.45 0.85 1"/>
    </body>
  </worldbody>

  <sensor>
    <framepos name="position" objtype="body" objname="block" reftype="body" refname="goal"/>
    <framequat name="orientation" objtype="body" objname="block" reftype="body" refname="goal"/>
  </sensor>

  <statistic center="-0.05 0.375 0" extent="0.7"/>
</mujoco>
