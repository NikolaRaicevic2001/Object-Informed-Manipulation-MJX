<mujoco model="xarm6_pusht_ycb_clutter_point">
  <!-- Point-robot twin of ycb_clutter.xml -- see common_point.xml. Nearest
       obstacle (domino_sugar) is at (0.08, 0.25); the pusher's start at
       (0, -0.18) is well clear on the opposite side of the block. -->
  <include file="common_point.xml"/>
  <include file="tee.xml"/>

  <asset>
    <mesh name="spam_can" file="assets/spam_can.obj" maxhullvert="32"/>
    <mesh name="mustard_bottle" file="assets/mustard_bottle.obj"
      maxhullvert="32"/>
  </asset>

  <worldbody>
    <camera name="front" pos="1.4907 0.3750 0.8684"
      xyaxes="0.0000 1.0000 -0.0000 -0.4226 0.0000 0.9063"/>

    <geom class="tabletop_obstacle" name="obs_box" type="box" size="0.05 0.05 0.05" pos="0.2 0.5 0.05"/>
    <geom class="tabletop_obstacle" name="spam_can" type="mesh"
      mesh="spam_can" pos="-0.1328 0.7234 0.0418"/>
    <geom class="tabletop_obstacle" name="domino_sugar" type="box"
      size="0.0875 0.0475 0.0300" pos="0.08 0.25 0.0300"/>
    <geom class="tabletop_obstacle" name="mustard_bottle" type="mesh"
      mesh="mustard_bottle" pos="0.6797 0.4995 0.0957"/>

    <body name="pusher" pos="0.0 -0.18 0.025">
      <joint name="root_x" type="slide" axis="1 0 0" damping="0.05"/>
      <joint name="root_y" type="slide" axis="0 1 0" damping="0.05"/>
      <geom name="pusher" type="sphere" size="0.02" mass="1.0" rgba="1 0 0 1"/>
      <site name="pusher" pos="0 0 0" rgba="0 0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="x_motor" joint="root_x" ctrllimited="true" ctrlrange="-0.6 0.6" kv="100" forcerange="-200 200"/>
    <velocity name="y_motor" joint="root_y" ctrllimited="true" ctrlrange="-0.6 0.6" kv="100" forcerange="-200 200"/>
  </actuator>

  <keyframe>
    <key name="start" qpos="0 0 0 0 0"/>
  </keyframe>
</mujoco>
