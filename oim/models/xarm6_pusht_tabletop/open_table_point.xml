<mujoco model="xarm6_pusht_open_table_point">
  <!-- Point-robot twin of open_table.xml -- see common_point.xml. No
       obstacles, so the pusher's start at (0, -0.18), south of the block,
       is clear by construction. -->
  <include file="common_point.xml"/>
  <include file="tee.xml"/>

  <worldbody>
    <camera name="front" pos="1.4907 0.3750 0.8684"
      xyaxes="0.0000 1.0000 -0.0000 -0.4226 0.0000 0.9063"/>

    <!-- Declared after tee.xml's `block`, matching pusht_clutter.xml's
         ordering -- oim/tasks/pusht.py relies on the point robot's block
         appearing first in qpos. z matches the block's own (0.025) for
         side contact at the same height. -->
    <body name="pusher" pos="0.0 -0.18 0.025">
      <joint name="root_x" type="slide" axis="1 0 0" damping="0.05"/>
      <joint name="root_y" type="slide" axis="0 1 0" damping="0.05"/>
      <!-- solref softer than the scene default (0.004 1): the block's
           sustained push force is pinned at mu*m*g = 7.85 N by the limit
           surface and no actuator setting changes it, but first contact
           spikes to 254 N at the 0.6 m/s command limit. 0.02 s cuts that to
           77 N for 2.7 mm of squish (was 1.0 mm) and no loss of pushing
           speed. Also narrows a stiffness mismatch: MuJoCo clamps the
           reference time constant to 2*timestep, so the planner already
           sees 0.1 s at planning_dt=0.05 while execution ran 0.004 s. -->
      <geom name="pusher" type="sphere" size="0.02" mass="1.0" rgba="1 0 0 1" solref="0.02 1"/>
      <site name="pusher" pos="0 0 0" rgba="0 0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="x_motor" joint="root_x" ctrllimited="true" ctrlrange="-0.6 0.6" kv="100" forcerange="-60 60"/>
    <velocity name="y_motor" joint="root_y" ctrllimited="true" ctrlrange="-0.6 0.6" kv="100" forcerange="-60 60"/>
  </actuator>

  <!-- Identity displacement: block and pusher both start exactly at their
       bodies' own declared `pos` above. Without this, oim/runtime/mjcf.py's
       point_start_qpos falls back to POINT_START_QPOS (clutter's own
       offset), not this scene's. -->
  <keyframe>
    <key name="start" qpos="0 0 0 -0.00002 0 0"/>
  </keyframe>
</mujoco>
