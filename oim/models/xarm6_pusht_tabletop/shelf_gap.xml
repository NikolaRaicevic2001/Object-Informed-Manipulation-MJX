<mujoco model="xarm6_pusht_shelf_gap">
  <!-- Push the T between two shelves -- open_table plus two large static
       blocks that leave a gap between them.

       IsaacGym conf/task/sim_task03.yaml.

       conf/actors/shelf_1.yaml / shelf_2.yaml: box, full size
       0.2 x 0.25 x 0.2 m, init_pos [1.1, 0.05, 0.24] and [0.7, 0.05, 0.24]
       -> half-extents (0.10, 0.125, 0.10) at (0.4, 0.5) and (0.0, 0.5)
       after the (-0.7, +0.45) shift, resting on the tabletop.

       DEPARTURE from those numbers: each shelf is moved 0.05 m outward in
       x, to (0.45, 0.5) and (-0.05, 0.5). IsaacGym's own spacing leaves a
       gap of x in [0.1, 0.3] -- exactly 0.2 m, and the T-block's crossbar
       is exactly 0.2 m long, so straight through is a zero-clearance
       squeeze that no sampled rollout can be expected to thread. The gap
       is now x in [0.05, 0.35], 0.3 m wide, leaving 5 cm either side of
       the crossbar. Widened symmetrically about x = 0.2, which is the
       goal's own x, so the straight-through route stays the centred one
       and going around the outside (x < -0.15 or x > 0.55) remains the
       alternative.

       oim/utils/scenes.py carries the matching Boxes; tests/test_scenes.py
       fails if the two drift apart. -->
  <include file="common.xml"/>
  <include file="tee.xml"/>

  <worldbody>
    <!-- Own camera, steeper and translated a little from the other three
         tabletop scenes': at the shared elevation=-25 the 0.2 m-tall
         shelves below block the view of the gap and the pusher between
         them, even though nothing falls outside the frame -- elevation
         dropped to -60 fixes that. Same azimuth=180 as the shared camera
         (an azimuth pan was tried instead and reverted -- rotating
         changes the viewing angle, not just what's centred). Instead the
         lookat/pos pair is translated +0.1 along the camera's own right
         axis (world +y at azimuth=180) to bring the arm closer to frame
         centre: lookat (-0.05, 0.475, 0.15) instead of the shared
         (-0.05, 0.375, 0.15), same distance=1.7 -- converted to explicit
         pos/xyaxes the same way (see tee.xml's former camera comment, now
         moved here since it no longer applies to all four scenes). -->
    <camera name="front" pos="0.8000 0.4750 1.6222"
      xyaxes="0.0000 1.0000 0.0000 -0.8660 0.0000 0.5000"/>

    <geom class="tabletop_obstacle" name="shelf_1" type="box" size="0.10 0.125 0.10" pos="0.45 0.5 0.10"/>
    <geom class="tabletop_obstacle" name="shelf_2" type="box" size="0.10 0.125 0.10" pos="-0.05 0.5 0.10"/>
  </worldbody>
</mujoco>
