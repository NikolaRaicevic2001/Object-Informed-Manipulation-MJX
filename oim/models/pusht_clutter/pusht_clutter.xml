<mujoco model="pusht_clutter">
  <!-- integrator="implicitfast" treats the velocity actuators' velocity
       feedback implicitly. With explicit Euler the pusher actuator is only
       stable for dt < 2*m/kv = 0.02 s, so a planning timestep of 0.05 s
       makes the planner's rollouts diverge (the pusher "flies away"), even
       though the fine-timestep execution model looks fine. -->
  <option timestep="0.01" gravity="0 0 -9.81" iterations="20" ls_iterations="20" integrator="implicitfast"/>

  <default>
    <velocity ctrllimited="true" ctrlrange="-2.0 2.0" kv="100" forcerange="-200 200"/>
    <geom friction="0.5 0.005 0.0001" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    <default class="goal">
      <geom conaffinity="0" contype="0" rgba="0 1 0 0.3"/>
    </default>
    <!-- The object block's horizon endpoint x^{o*}_H, drawn as a ghost of
         the pushed object -- what the robot block aims at under
         `local_goal` tracking (see oim/tasks/pusht.py). Blue, not the
         goal's green: it is the last pose of the object block's own plan,
         which oim/runtime/overlay.py already draws in blue. Fainter
         than the goal, because it moves every control step and must not
         compete with the fixed target. -->
    <default class="local_goal">
      <geom conaffinity="0" contype="0" rgba="0 0.30 0.95 0.25"/>
    </default>
    <default class="obstacle">
      <geom conaffinity="1" contype="1" rgba="0.5 0.5 0.5 1"/>
    </default>
  </default>

  <worldbody>
    <!-- The goal marker's geoms mirror the block's exactly: same sizes, same
         body-frame offsets, same z half-extent. The goal body's pos/quat is
         the block pose at the goal, so an aligned block occupies precisely
         the marker's volume -- overlap is the success criterion, by eye, and
         the stem makes the 180-degree orientation ambiguity of a bare
         crossbar impossible. Keep in sync with block_crossbar/block_stem
         below, and with oim.objects.planar_pushing.t_shape_footprint. -->
    <body name="goal" mocap="true" pos="0.50 0.48 0.03" quat="0.92388 0 0 0.38268">
      <geom class="goal" name="goal_crossbar" type="box" size="0.090 0.015 0.020" pos="0.0 0.030 0.0"/>
      <geom class="goal" name="goal_stem" type="box" size="0.015 0.060 0.020" pos="0.0 -0.045 0.0"/>
    </body>

    <!-- Ghost of the pushed object at the object block's horizon endpoint
         x^{o*}_H, moved every control step by the runners (mocap, so it is
         written straight into mocap_pos/mocap_quat and never simulated).
         Geoms mirror `block`'s exactly, at the same z, so its overlap with
         the block reads the same way the goal marker's does. `pos`/`quat`
         here are only the pre-first-plan placeholder; oim/runtime/mjcf.py
         parks it on the block's start pose. -->
    <body name="local_goal" mocap="true" pos="0.0 0.0 0.03" quat="1 0 0 0">
      <geom class="local_goal" name="local_goal_crossbar" type="box" size="0.090 0.015 0.020" pos="0.0 0.030 0.0"/>
      <geom class="local_goal" name="local_goal_stem" type="box" size="0.015 0.060 0.020" pos="0.0 -0.045 0.0"/>
    </body>

    <body name="block" pos="0.0 0.0 0.03">
      <joint name="T_x" type="slide" axis="1 0 0" frictionloss="7.848" damping="0.0"/>
      <joint name="T_y" type="slide" axis="0 1 0" frictionloss="7.848" damping="0.0"/>
      <joint name="T_z" type="hinge" axis="0 0 1" frictionloss="0.47088" damping="0.0"/>
      <geom name="block_crossbar" type="box" size="0.090 0.015 0.020" pos="0.0 0.030 0.0" mass="1.0" rgba="0.2 0.45 0.85 1"/>
      <geom name="block_stem" type="box" size="0.015 0.060 0.020" pos="0.0 -0.045 0.0" mass="1.0" rgba="0.2 0.45 0.85 1"/>
    </body>

    <body name="pusher" pos="-0.05 -0.06 0.03">
      <joint name="root_x" type="slide" axis="1 0 0" damping="0.05"/>
      <joint name="root_y" type="slide" axis="0 1 0" damping="0.05"/>
      <geom name="pusher" type="sphere" size="0.012" mass="1.0" rgba="1 0 0 1"/>
      <site name="pusher" pos="0 0 0" rgba="0 0 0 0"/>
    </body>

    <geom class="obstacle" name="obs_circle" type="sphere" size="0.04" pos="0.08 0.32 0.03"/>
    <geom class="obstacle" name="obs_box" type="box" size="0.04 0.035 0.02" pos="0.38 0.10 0.03" euler="0 0 0.25"/>
    <geom class="obstacle" name="obs_tri" type="box" size="0.05 0.05 0.02" pos="0.15 0.47 0.03"/>
  </worldbody>

  <actuator>
    <velocity name="x_motor" joint="root_x"/>
    <velocity name="y_motor" joint="root_y"/>
  </actuator>

  <sensor>
    <framepos name="position" objtype="body" objname="block" reftype="body" refname="goal"/>
    <framequat name="orientation" objtype="body" objname="block" reftype="body" refname="goal"/>
  </sensor>
</mujoco>
